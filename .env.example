# ==============================================================================
# Cucina SA Environment Variables
# ==============================================================================

# Supabase (Database for Dynamic Content & Menus)
# ------------------------------------------------------------------------------
# In Vercel / Netlify project settings, add these variables:
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# (Legacy aliases also supported: VITE_SUPABASE_ANON_KEY, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY)

# Owner Portal Authentication
# ------------------------------------------------------------------------------
ADMIN_PASSWORD="cucina2026"

